{
  "name": "tsukamae",
  "version": "2.0.0",
  "description": "A personal offline living dex tracker (fork of pokedextracker.com)",
  "main": "electron/main.js",
  "scripts": {
    "build": "yarn build:bundle && yarn build:public",
    "build:bundle": "node -e \"fs.rmSync('build',{recursive:true,force:true})\" && webpack --node-env production",
    "build:public": "node -e \"fs.cpSync('public','build',{recursive:true})\"",
    "dataset": "node scripts/generate-dataset.mjs && node scripts/enrich-species.mjs",
    "dataset:species": "node scripts/enrich-species.mjs",
    "sprites:balls": "node scripts/fetch-ball-sprites.mjs",
    "sprites:marks": "node scripts/fetch-origin-marks.mjs",
    "electron:build": "yarn lint:all && yarn build && electron-builder --win",
    "electron:dev": "concurrently -k \"yarn start\" \"wait-on http-get://localhost:9898 && electron .\"",
    "electron:dev:fresh": "concurrently -k \"yarn start\" \"wait-on http-get://localhost:9898 && electron . --fresh\"",
    "icon": "node scripts/generate-app-icon.mjs",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx,.mjs --max-warnings 0 .",
    "lint:all": "yarn lint && yarn lint:types && yarn lint:themes",
    "lint:themes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-themes.mjs",
    "lint:types": "tsc --noEmit",
    "start": "webpack serve",
    "start:fresh": "webpack serve --env fresh"
  },
  "build": {
    "appId": "com.jonnycorp.tsukamae",
    "productName": "tsukamae",
    "files": [
      "build/**/*",
      "!build/**/*.map",
      "electron/**/*",
      "!electron/installer.nsh",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "en-US",
      "ja"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "installerLanguages": [
        "en_US",
        "ja_JP"
      ],
      "include": "electron/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/icon.png"
    },
    "publish": {
      "provider": "github"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.22.6",
    "@babel/preset-env": "^7.22.4",
    "@babel/preset-react": "^7.22.5",
    "@babel/preset-typescript": "^7.22.5",
    "@fortawesome/fontawesome-svg-core": "^6.0.0",
    "@fortawesome/free-solid-svg-icons": "^6.0.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^5.60.1",
    "@typescript-eslint/parser": "^5.60.1",
    "babel-loader": "^9.1.2",
    "classnames": "^2.3.2",
    "concurrently": "^10.0.5",
    "css-loader": "^6.8.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.44.0",
    "eslint-plugin-react": "^7.32.2",
    "html-webpack-plugin": "^5.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.62.1",
    "sass-loader": "^13.3.1",
    "style-loader": "^3.3.3",
    "typescript": "^5.2.2",
    "wait-on": "^7.2.0",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.1",
    "webpack-dev-server": "^4.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonnycorp/tsukamae.git"
  },
  "author": "Jay",
  "license": "MIT"
}
