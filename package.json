{
  "name": "tsukamae",
  "version": "1.0.0",
  "description": "A personal offline living dex tracker (fork of pokedextracker.com)",
  "main": "electron/main.js",
  "scripts": {
    "build": "npm run build:bundle && npm run build:public",
    "build:bundle": "node -e \"fs.rmSync('build',{recursive:true,force:true})\" && webpack --node-env production",
    "build:public": "node -e \"fs.cpSync('public','build',{recursive:true})\"",
    "dataset": "node scripts/generate-dataset.mjs",
    "electron:build": "yarn build && electron-builder --win",
    "electron:dev": "concurrently -k \"yarn start\" \"wait-on http-get://localhost:9898 && electron .\"",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx --max-warnings 0 .",
    "lint:all": "yarn lint && yarn lint:types",
    "lint:types": "tsc --noEmit",
    "start": "webpack serve"
  },
  "build": {
    "appId": "com.jonnycorp.tsukamae",
    "productName": "Tsukamae",
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@babel/core": "^7.22.6",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/preset-env": "^7.22.4",
    "@babel/preset-react": "^7.22.5",
    "@babel/preset-typescript": "^7.22.5",
    "@fortawesome/fontawesome-svg-core": "^1.2.27",
    "@fortawesome/free-brands-svg-icons": "^5.12.1",
    "@fortawesome/free-solid-svg-icons": "^5.12.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@tanstack/react-query": "^4.29.19",
    "@types/lodash": "^4.14.195",
    "@types/react-dom": "^18.2.6",
    "babel-loader": "^9.1.2",
    "classnames": "^2.3.2",
    "core-js": "^3.30.2",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.5.1",
    "lodash": "^4.17.21",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "sass": "^1.62.1",
    "sass-loader": "^13.3.1",
    "style-loader": "^3.3.3",
    "typescript": "5.0.4",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.1"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^4.29.9",
    "@typescript-eslint/eslint-plugin": "^5.60.1",
    "@typescript-eslint/parser": "^5.60.1",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.44.0",
    "eslint-plugin-react": "^7.32.2",
    "wait-on": "^7.2.0",
    "webpack-dev-server": "^4.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonnycorp/tsukamae.git"
  },
  "author": "Jay",
  "license": "MIT"
}
